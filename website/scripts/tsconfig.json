{
  "compilerOptions": {
    "module": "CommonJS",
    "esModuleInterop": true,
    "target": "ES2020",
    "moduleResolution": "node",
    "outDir": "dist",
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"]
    },
    "allowJs": true
  },
  "include": ["./**/*", "../src/**/*.ts"],
  "exclude": ["node_modules"]
} 